# Environment variables — copy this to .env and fill in your values.
# NEVER commit .env to version control.
#
# The prebuild gate (scripts/check-env.mjs) enforces the REQUIRED group on
# production builds and fails loudly if any are missing.

# ─── REQUIRED in production ───────────────────────────────────────────────────

# PostgreSQL (Neon). DATABASE_URL is the pooled runtime connection;
# DIRECT_URL is unpooled, used by `prisma migrate deploy`.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DIRECT_URL=postgresql://user:password@host/db?sslmode=require

# Signs the auth_token session cookie (HS256). Generate:
#   openssl rand -base64 48
JWT_SECRET=replace-with-openssl-rand-base64-48

# Canonical app URL — OAuth/MCP issuer and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Inference backends — at least ONE required in production ────────────────
# The prebuild gate (check-env.mjs) fails the build if neither is set, since
# every chat request would otherwise 503.

# Primary chat backend (most personas).
GROQ_API_KEY=[REMOVED-ROTATED-SECRET]

# Astro 5 / DeepCode pipeline backend.
OPENCODE_ZEN_API_KEY=your-opencode-zen-key

# ─── Optional ────────────────────────────────────────────────────────────────

# /dev panel unlock (REQUIRED in production if you want the outage-mode dev
# panel to be unlockable at all; without it the panel stays sealed).
# DEV_PANEL_PASSWORD=pick-something-long

# Shared rate-limit counters (Upstash Redis or Vercel KV, REST API). When set,
# rate limits are enforced globally across serverless instances instead of
# per-instance. Either pair works:
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# External memory/search backend (services/backend). The app degrades
# gracefully without it: web search falls back to keyless DuckDuckGo and
# user memory switches off.
# BACKEND_URL=http://localhost:8000
# BACKEND_API_KEY=shared-secret-between-next-and-backend

# Public HTTPS origin for the Telegram webhook route (only if using Telegram).
# PUBLIC_APP_URL=https://your-domain.example

# x402 Store (accountless, agent-first — see docs/dev/x402-store.md). Unset
# leaves /store visible but checkout + paid inference disabled. Setting the
# merchant wallet below enables it (default network base-sepolia + free
# testnet facilitator; mainnet requires X402_FACILITATOR_URL too).
# X402_PAY_TO=0xYourMerchantWalletAddress
# X402_NETWORK=base-sepolia
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_FACILITATOR_API_KEY=

# Composio connectors (Apps menu / Settings → Connectors) and the standalone
# tool-router agent (`npm run agent`, agent.ts). Absent means the feature is off.
# COMPOSIO_API_KEY=your-composio-key

# Anthropic key — only used by the standalone agent.ts script.
# ANTHROPIC_API_KEY=sk-ant-...

# Composio user id for agent.ts (in-app, Tripplet user ids are used instead).
# COMPOSIO_USER_ID=user_mq21yb
