{
    "name": "tripplet-computer",
    "version": "0.1.0",
    "private": true,
    "description": "Tripplet Computer — a local agent workstation for macOS",
    "type": "module",
    "scripts": {
        "dev": "cargo run --manifest-path src-tauri/Cargo.toml",
        "build": "cargo build --release --manifest-path src-tauri/Cargo.toml",
        "bundle": "cargo tauri build",
        "icons": "node scripts/make-icons.mjs",
        "test": "npm run test:rust && npm run test:ui",
        "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
        "test:ui": "node --test ui/js/*.test.mjs",
        "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
        "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml"
    }
}
