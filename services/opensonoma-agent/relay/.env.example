# OpenSonoma relay configuration.
#
# Copy to .env (the server auto-loads it) or set these in your process env.
# With no Supabase vars set the relay runs in IN-MEMORY DEV MODE: no
# persistence and JWTs are NOT verified (account_id is trusted). That mode is
# exactly what the Tripplet app's /api/connect routes target for local pairing.

# Port the relay listens on (ws path is always /ws).
PORT=8080

# Public URL announced on the /health endpoint (and used in logs).
RELAY_PUBLIC_URL=ws://localhost:8080/ws

# Tripplet app bridge (RECOMMENDED for production).
# Set this to the SAME value as the Next app's JWT_SECRET. The relay then
# verifies each client's Tripplet session token (HS256) and uses its `userId`
# claim as the account id — so a signed-in user can only pair/drive their own
# devices, with no Supabase user required. Leave blank to fall back to Supabase
# JWT verification (if configured) or dev-trust memory mode.
TRIPPLET_JWT_SECRET=

# Supabase (optional — enables persistence + Supabase JWT verification).
# NOTE: the schema FKs account_id -> auth.users(id). Pair Supabase persistence
# with Supabase auth; with TRIPPLET_JWT_SECRET the account id is the app userId,
# best used with in-memory persistence (or a Tripplet-Postgres adapter).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
