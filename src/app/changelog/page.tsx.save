        date: 'March 24, 2026',
        title: 'Rock-Solid Auth & Site Stability',
        changes: [
            { type: 'fixed', text: 'Password reset token flow now uses proper one-way hashing — the secret token lives in the URL, only a hash lives in the database. Even if the DB is ever compromised, reset links stay safe.' },
            { type: 'fixed', text: 'Forgot-password endpoint is now rate-limited to 3 requests per hour per IP — no more email flooding.' },
            { type: 'fixed', text: 'Login endpoint rate-limited to 10 attempts per 15 minutes per IP to stop brute-force attacks in their tracks.' },
