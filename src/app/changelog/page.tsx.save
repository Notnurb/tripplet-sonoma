const ease = [0.25, 0.46, 0.45, 0.94] as const;

type ChangelogEntry = {
    version: string;
    date: string;
    title: string;
    changes: { type: 'added' | 'improved' | 'fixed'; text: string }[];
};

const changelog: ChangelogEntry[] = [
    {9;6u
