const typeStyles: Record<string, { label: string; className: string }> = {
    added: { label: 'Added', className: 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' },
    improved: { label: 'Improved', className: 'bg-foreground/5 text-foreground/70 border-foreground/10' },
    fixed: { label: 'Fixed', className: 'bg-amber-500/10 text-amber-500 border-amber-500/20' },
};

export default function Changelog() {
    return (
        <div className="flex min-h-screen w-full flex-col bg-background grain-overlay relative">
            <LandingHeader />

            <main className="grow">
                <section className="mx-auto w-full max-w-3xl px-4 pt-32 pb-20 md:pt-40 md:pb-28">
                    <div className="text-center mb-16">
                        <motion.h1
                            initial={{ opacity: 0, y: 20, filter: 'blur(10px)' }}
                            animate={{ opacity: 1, y: 0, filter: 'blur(0px)' }}
                            transition={{ duration: 0.7, delay: 0.1, ease }}
                            className="gradient-text text-4xl font-bold tracking-tight md:text-5xl"
                        >
                            Changelog
                        </motion.h1>
                        <motion.p
                            initial={{ opacity: 0, y: 16, filter: 'blur(6px)' }}
                            animate={{ opacity: 1, y: 0, filter: 'blur(0px)' }}
                            transition={{ duration: 0.6, delay: 0.25, ease }}
                            className="mt-4 text-lg text-muted-foreground"
                        >
                            What&apos;s new in Tripplet.
                        </motion.p>
                    </div>

                    <div className="relative">
                        {/* Animated vertical line */}
                        <motion.div
                            className="absolute left-4 top-0 bottom-0 w-px bg-border md:left-6"
                            initial={{ scaleY: 0, originY: 0 }}
                            animate={{ scaleY: 1 }}
                            transition={{ duration: 1.5, delay: 0.3, ease }}
                        />

                        <div className="space-y-16">
                            {changelog.map((entry, i) => (
                                <motion.div
                                    key={entry.version}
                                    initial={{ opacity: 0, x: -20, filter: 'blur(6px)' }}
                                    whileInView={{ opacity: 1, x: 0, filter: 'blur(0px)' }}
                                    viewport={{ once: true, margin: '-60px' }}
                                    transition={{ duration: 0.6, delay: 0.1, ease }}
                                    className="relative pl-12 md:pl-16"
                                >
                                    {/* Animated dot */}
                                    <motion.div
                                        className={`absolute left-2.5 top-1 h-3 w-3 rounded-full border-2 bg-background md:left-4.5 ${i === 0 ? 'border-violet-500 ring-2 ring-violet-500/20' : 'border-border'}`}
                                        initial={{ scale: 0 }}
                                        whileInView={{ scale: 1 }}
                                        viewport={{ once: true }}
                                        transition={{ duration: 0.4, delay: 0.2, type: 'spring', stiffness: 300 }}
                                    />

                                    <div className="flex flex-wrap items-baseline gap-3 mb-4">
                                        <motion.span
                                            className={`rounded-full border px-3 py-0.5 text-xs font-semibold ${i === 0 ? 'border-violet-500/40 bg-violet-500/10 text-violet-400' : 'border-border bg-card'}`}
                                            whileHover={{ scale: 1.05 }}
                                            transition={{ type: 'spring', stiffness: 400, damping: 15 }}
                                        >
                                            v{entry.version}
                                        </motion.span>
                                        {i === 0 && (
                                            <span className="rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2.5 py-0.5 text-[10px] font-semibold text-emerald-400 uppercase tracking-wider">
                                                Latest
                                            </span>
                                        )}
                                        <span className="text-xs text-muted-foreground">{entry.date}</span>
                                    </div>

                                    <h2 className="text-lg font-semibold mb-4">{entry.title}</h2>

                                    <ul className="space-y-2">
                                        {entry.changes.map((change, j) => {
                                            const style = typeStyles[change.type];
                                            return (
                                                <motion.li
                                                    key={j}
                                                    initial={{ opacity: 0, x: -12 }}
                                                    whileInView={{ opacity: 1, x: 0 }}
                                                    viewport={{ once: true }}
                                                    transition={{ duration: 0.35, delay: j * 0.04, ease }}
                                                    className="flex items-start gap-2.5"
                                                >
                                                    <span className={`mt-0.5 shrink-0 rounded border px-1.5 py-0.5 text-[10px] font-semibold uppercase ${style.className}`}>
                                                        {style.label}
                                                    </span>
                                                    <span className="text-sm text-muted-foreground leading-relaxed">{change.text}</span>
                                                </motion.li>
                                            );
                                        })}
                                    </ul>
                                </motion.div>
                            ))}
                        </div>
                    </div>
                </section>
            </main>

            <LandingFooter />
        </div>
    );
}
